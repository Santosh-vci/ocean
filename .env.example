COMPOSE_PROJECT_NAME=coalflow

# Django
DJANGO_SECRET_KEY=change-me-in-real-environments
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,proxy
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1:8080
DJANGO_TIME_ZONE=Asia/Makassar
DJANGO_LOG_LEVEL=INFO
DJANGO_REQUEST_LOG_LEVEL=WARNING

# Database
POSTGRES_DB=coalflow
POSTGRES_USER=coalflow
POSTGRES_PASSWORD=coalflow
DATABASE_URL=postgresql://coalflow:coalflow@db:5432/coalflow

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object storage
MINIO_ROOT_USER=coalflow
MINIO_ROOT_PASSWORD=coalflow-dev-password
S3_ENDPOINT_URL=http://object-store:9000
S3_BUCKET_NAME=coalflow-local
AWS_ACCESS_KEY_ID=coalflow
AWS_SECRET_ACCESS_KEY=coalflow-dev-password
AWS_STORAGE_BUCKET_NAME=coalflow-local
AWS_S3_REGION_NAME=us-east-1
EXPORT_STORAGE_ROOT=/tmp/coalflow_exports

# Seeded development admin
SEED_ADMIN_EMAIL=admin@coalflow.local
SEED_ADMIN_PASSWORD=admin12345

# Frontend
VITE_API_BASE_URL=/api
